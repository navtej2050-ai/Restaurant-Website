
<!DOCTYPE html>
<html>
<head>
    <title>The Olive Table - Restaurant</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f9f7f0;
            color: #333;
        }

        /* Navigation Bar */
        header {
            background-color: #263d32;
            color: white;
            padding: 20px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 25px;
            font-weight: bold;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 22px;
            font-size: 15px;
        }

        nav a:hover {
            color: #e6c98b;
        }

        /* Home Section */
        .home {
            height: 450px;
            background:
            linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)),
            url("https://images.unsplash.com/photo-1414235077428-338989a2e8c0")
            center/cover;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            color: white;
        }

        .home h1 {
            font-size: 48px;
            margin-bottom: 15px;
        }

        .home p {
            font-size: 19px;
        }

        /* Common Sections */
        section {
            padding: 55px 10%;
            text-align: center;
        }

        h2 {
            color: #263d32;
            font-size: 30px;
            margin-bottom: 20px;
        }

        /* About Section */
        .about p {
            max-width: 750px;
            margin: auto;
            line-height: 1.8;
            font-size: 16px;
        }

        /* Menu Section */
        .menu {
            background-color: #eeeae0;
        }

        .food-container {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 25px;
            margin-top: 30px;
        }

        .food-card {
            background: white;
            width: 260px;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 3px 12px rgba(0,0,0,0.12);
        }

        .food-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

        .food-card h3 {
            color: #263d32;
            margin: 15px 0 8px;
        }

        .food-card p {
            padding: 0 12px;
            font-size: 14px;
        }

        .price {
            color: #a66b32;
            font-weight: bold;
            padding: 12px;
            font-size: 18px;
        }

        /* Contact Section */
        .contact {
            background-color: #f9f7f0;
            line-height: 2;
        }

        .contact p {
            font-size: 16px;
        }

        /* Location Section */
        .location {
            background-color: #eeeae0;
        }

        .location iframe {
            width: 100%;
            max-width: 750px;
            height: 300px;
            border: 0;
            border-radius: 10px;
            margin-top: 20px;
        }

        /* Footer */
        footer {
            background-color: #263d32;
            color: white;
            text-align: center;
            padding: 20px;
        }

        @media (max-width: 650px) {
            header {
                flex-direction: column;
                gap: 15px;
            }

            nav a {
                margin: 0 7px;
                font-size: 13px;
            }

            .home h1 {
                font-size: 34px;
            }

            section {
                padding: 40px 5%;
            }
        }
    </style>
</head>

<body>

    <!-- Header -->
    <header>
        <div class="logo">🌿 The Olive Table</div>

        <nav>
            <a href="#home">Home</a>
            <a href="#about">About</a>
            <a href="#menu">Menu</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <!-- Home -->
    <div class="home" id="home">
        <div>
            <h1>Welcome to The Olive Table</h1>
            <p>Good Food. Great Moments. Beautiful Memories.</p>
        </div>
    </div>

    <!-- About Us -->
    <section class="about" id="about">
        <h2>About Our Restaurant</h2>

        <p>
            The Olive Table is a modern restaurant that brings together
            delicious food, wonderful flavours and a comfortable dining
            experience. We believe that every meal should be special.
            Our restaurant offers a variety of freshly prepared dishes
            made with quality ingredients. Visit us with your family
            and friends and enjoy unforgettable moments.
        </p>
    </section>

    <!-- Food Menu -->
    <section class="menu" id="menu">
        <h2>Our Food Menu</h2>
        <p>Explore some of our customer favourites!</p>

        <div class="food-container">

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1473093295043-cdd812d0e601"
                alt="Pasta">

                <h3>Italian Pasta</h3>
                <p>Creamy pasta with fresh herbs and cheese.</p>
                <div class="price">₹249</div>
            </div>

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd"
                alt="Burger">

                <h3>Classic Burger</h3>
                <p>Fresh vegetables, cheese and crispy patty.</p>
                <div class="price">₹199</div>
            </div>

            <div class="food-card">
               <img src="https://images.unsplash.com/photo-1513104890138-7c749659a591"
alt="Cheese Pizza">

                <h3>Cheese Pizza</h3>
                <p>Delicious pizza topped with extra cheese.</p>
                <div class="price">₹299</div>
            </div>

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1512621776951-a57141f2eefd"
                alt="Salad">

                <h3>Fresh Salad</h3>
                <p>A healthy mix of fresh vegetables.</p>
                <div class="price">₹149</div>
            </div>

        </div>
    </section>

    <!-- Contact -->
    <section class="contact" id="contact">
        <h2>Contact Us</h2>

        <p><b>Restaurant:</b> The Olive Table</p>
        <p><b>Phone:</b> +91 98765 43210</p>
        <p><b>Email:</b> theolivetable@example.com</p>
        <p><b>Opening Hours:</b> 11:00 AM – 10:00 PM</p>
    </section>

    <!-- Location -->
    <section class="location">
        <h2>Find Us Here</h2>

        <p>Sector 70, Mohali, Punjab, India</p>

        <iframe
            src="https://maps.google.com/maps?q=Sector%2070%20Mohali&t=&z=13&ie=UTF8&iwloc=&output=embed">
        </iframe>
    </section>

    <!-- Footer -->
    <footer>
        <p>© 2026 The Olive Table | All Rights Reserved</p>
        <p>Thank you for visiting us!</p>
    </footer>

</body>
</html>
